# ── Cloud Portal ─────────────────────────────────────────────────────────────
# URL of your deployed backend (Render)
SERVER_URL=https://your-app.onrender.com

# Unique secret token — generate any random string
# Paste the same value in the portal under Printer → Agent Token
AGENT_TOKEN=change-this-to-a-long-random-secret

# ── Optional: pre-configure a single printer ─────────────────────────────────
# If you only have one printer you can hardcode it here,
# otherwise the portal sends printer details with each job
# PRINTER_IP=192.168.1.100
# PRINTER_SERIAL=01A00C123456789
# PRINTER_ACCESS_CODE=12345678
